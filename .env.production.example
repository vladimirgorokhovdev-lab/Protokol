# Скопируй в .env.production на машине сборки (или задай в CI).
# Значения возьми из текущего Lovable / Supabase проекта (те же, что сейчас в проде).

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# --- Supabase Edge Functions (Secrets в Dashboard / CLI), не префикс VITE_ ---
# Через запятую, без пробелов после запятой можно с пробелами — парсер их обрежет.
# SUPABASE_ALLOWED_ORIGINS=https://xn--....xn--p1ai,https://www.xn--....xn--p1ai
# SITE_URL=https://xn--....xn--p1ai
